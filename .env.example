# ==============================================================================
# GUARDTECK SECURITY AUTOMATED DISPATCH - ENVIRONMENT CONFIGURATION TEMPLATE
# All external API keys use clear placeholder labels: YOUR_API_KEY_HERE
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MySQL 8.0 Database Connection
DATABASE_URL=mysql://dispatch_user:dispatch_secure_pass@localhost:3306/automated_dispatch

# Retell AI Voice Engine (Guardteck Dispatch Bot)
RETELL_API_KEY=YOUR_RETELL_API_KEY_HERE
RETELL_AGENT_ID=YOUR_RETELL_AGENT_ID_HERE
RETELL_WEBHOOK_SECRET=YOUR_RETELL_WEBHOOK_SECRET_HERE

# Twilio Elastic SIP Trunking & 5-Line Toll-Free Pool (BC Canada / NA-West)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_SIP_REGION=us-west-2
TWILIO_SIP_EDGE=umatilla
TWILIO_SIP_TERMINATION_URI=guardteck-dispatch.pstn.us2.twilio.com
TWILIO_PHONE_POOL=+18885550101,+18885550102,+18885550103,+18885550104,+18885550105
TWILIO_TOLLFREE_LINE_1=+18885550101
TWILIO_TOLLFREE_LINE_2=+18885550102
TWILIO_TOLLFREE_LINE_3=+18885550103
TWILIO_TOLLFREE_LINE_4=+18885550104
TWILIO_TOLLFREE_LINE_5=+18885550105

# Microsoft Teams Human-in-the-Loop Webhook
TEAMS_APPROVAL_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_TEAMS_WEBHOOK_URL_HERE
TEAMS_BOT_APP_ID=YOUR_TEAMS_BOT_APP_ID_HERE
TEAMS_BOT_APP_PASSWORD=YOUR_TEAMS_BOT_APP_PASSWORD_HERE

# Microsoft Graph API / Entra ID (Calendar & Email Notifications)
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID_HERE
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID_HERE
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET_HERE
DISPATCH_SHARED_MAILBOX=dispatch-alerts@guardteck.com

# Telephony Pacing & Safety Guardrails
DAILY_COST_CEILING_USD=25.00
MAX_CONCURRENT_CALLS=5
CALL_PACING_MS=1200
MAX_CALL_DURATION_MINUTES=6
MIN_RETRY_DELAY_MINUTES=45
